{
	"name": "qr-code-render-kit",
	"version": "0.0.1-beta.3",
	"description": "A type safe, typescript-first SVG QR code generator that supports multiple file download formats, styling options, customization options for refinded QR code generation.",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "tsup",
		"prepublishOnly": "npm run build",
		"render:svg": "tsx dev/dev.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RileyG00/qr-code-generator.git"
	},
	"keywords": [
		"qrcode",
		"qr",
		"code",
		"generator",
		"qr code generator",
		"qrcode-generator",
		"qrcode generator",
		"react qr code generator",
		"react qr code"
	],
	"author": "Riley Griffin",
	"license": "MIT",
	"type": "module",
	"bugs": {
		"url": "https://github.com/RileyG00/qr-code-generator/issues"
	},
	"homepage": "https://github.com/RileyG00/qr-code-generator#readme",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"devDependencies": {
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"prettier": "^3.9.6",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
